# All local artifacts live under local/ (bin build dist runs datasets outputs
# state_output); see bench/README.md for what each holds and what is rebuildable.
/local/
# A bare `go build ./cmd/...` at the root drops binaries here; build into
# local/bin/ instead.
/rwkv-cli
/rwkv-app
/rwkv-lab

.venv/
__pycache__/
/third_party/gorilla/
.DS_Store
.pnpm-store/
.gocache/
.zcode/
.zcodeignore
.agent-teams/

# bench/ is the data checkout, a separate git repository (docs/guides/data.md).
/bench/

# Claude 桌面 App 的本机预览配置（含绝对路径）
.claude/launch.json

# just-bash sidecar dependencies (scripts/build-justbash.sh installs them)
/native/justbash/node_modules/
