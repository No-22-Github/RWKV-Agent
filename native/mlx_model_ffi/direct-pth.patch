+private func readFFIModelConfig(from configData: Data) throws -> FFIModelConfig {
@@ -75,0 +76,4 @@ private func readFFIModelConfig(from configurationURL: URL) throws -> FFIModelCo
+private func readFFIModelConfig(from configurationURL: URL) throws -> FFIModelConfig {
