+    Impl(const std::string &path, const std::vector<PthTensorInfo> &index)
+        : zip(path) {
+        find_prefix();
+        records.reserve(index.size());
+        infos.reserve(index.size());
+        for (const auto &info : index) {
+            if (info.name.empty() || info.storage_key.empty()) {
+                throw std::runtime_error("invalid cached pth tensor index");
+            }
+            TensorRecord record;
+            record.name = info.name;
+            record.storage_key = info.storage_key;
+            record.dtype = info.dtype;
+            record.storage_size = info.storage_size;
+            record.offset = info.offset;
+            record.shape = info.shape;
+            record.stride = info.stride;
+            records.emplace(record.name, std::move(record));
+            infos.emplace(info.name, info);
+        }
