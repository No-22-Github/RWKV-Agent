@@ -601,0 +632,18 @@ std::vector<std::string> PthFile::tensor_names() const {
+bool PthFile::read_tensor_view(
+    const std::string &name,
+    PthTensorView &view) const {
+    view = {};
+    const TensorRecord *record = impl_->record(name);
+    if (!record || !contiguous(record->shape, record->stride)) return false;
+    const uint64_t elements = numel(record->shape);
+    if (record->offset > record->storage_size ||
+        elements > record->storage_size - record->offset) {
+        throw std::runtime_error("pth tensor view is out of storage bounds: " + name);
+    }
+    const size_t element_size = dtype_size(record->dtype);
+    view.data =
+        impl_->storage(*record) + record->offset * element_size;
+    view.byte_count = static_cast<size_t>(elements) * element_size;
+    return true;
+}
