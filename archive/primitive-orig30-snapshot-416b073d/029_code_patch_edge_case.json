{
  "name": "code_patch_edge_case",
  "title": "Code Patch Edge Case",
  "mode": "benchmark",
  "system": "base",
  "prompt": "NOTES.md and README.md describe what parse_date must accept. Edit parser.py with write_file only, run_tests until PASS, submit: tests passed",
  "tools": "write",
  "environment": {
    "kind": "emulated",
    "files": {
      "parser.py": [
        "from datetime import datetime",
        "",
        "",
        "def parse_date(text):",
        "    return datetime.strptime(text, \"%Y-%m-%d\").date().isoformat()"
      ],
      "test_parser.py": [
        "from parser import parse_date",
        "",
        "",
        "def test_iso_date():",
        "    assert parse_date(\"2026-07-05\") == \"2026-07-05\"",
        "",
        "",
        "def test_slash_date_with_spaces():",
        "    assert parse_date(\" 2026/07/05 \") == \"2026-07-05\"",
        "",
        "",
        "if __name__ == \"__main__\":",
        "    test_iso_date()",
        "    test_slash_date_with_spaces()",
        "    print(\"PASS\")"
      ],
      "README.md": [
        "Edit ./parser.py only. Verify with the run_tests tool (not shell).",
        "Tests cover ISO dates and slash dates with leading/trailing spaces."
      ],
      "NOTES.md": [
        "parse_date must strip surrounding whitespace.",
        "It must accept YYYY-MM-DD and also YYYY/MM/DD.",
        "Keep returning an ISO date string (YYYY-MM-DD)."
      ]
    },
    "expected_submit": "tests passed",
    "required_tools": [
      "read_file",
      "write_file",
      "run_tests",
      "submit"
    ],
    "scenario": "date_parser_patch"
  },
  "evaluation": "submit_after_tests",
  "max_turns": 22,
  "suite": "original"
}
