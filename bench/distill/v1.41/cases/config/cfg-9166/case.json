    "scripts/backup.sh": "#!/bin/sh\n/opt/old-app/bin/backup --dest /opt/old-app-data/backups\n# config lives in /opt/old-app/conf\necho done\n",
    "scripts/deploy.sh": "#!/bin/sh\ncd /opt/old-app/releases\n./install.sh /opt/old-app/conf/prod.env\nsystemctl restart app\n",
    "scripts/healthcheck.sh": "#!/bin/sh\ncurl -fs http://localhost:8080/health || exit 1\ntest -x /opt/old-app/bin/app\n",
