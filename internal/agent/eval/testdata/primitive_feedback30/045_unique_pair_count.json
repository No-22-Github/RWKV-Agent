{
  "name": "unique_pair_count",
  "title": "Unique Pair Count",
  "mode": "benchmark",
  "system": "base",
  "prompt": "pairs.csv lists a,b. Count distinct unordered pairs (1,2 same as 2,1). Submit the count.",
  "tools": "nav",
  "environment": {
    "kind": "emulated",
    "files": {
      "pairs.csv": [
        "a,b",
        "1,2",
        "2,1",
        "3,4",
        "1,2",
        "5,6"
      ]
    },
    "expected_submit": "3",
    "required_tools": [
      "submit"
    ]
  },
  "evaluation": "submit",
  "max_turns": 12,
  "suite": "fb_multihop"
}
