{
  "name": "lts_eol_status",
  "title": "Current LTS EOL Status",
  "mode": "benchmark",
  "system": "base",
  "prompt": "In support_matrix.md, what is the support status of version 8.1? Report exactly one of: current, LTS, or EOL.",
  "tools": "nav",
  "environment": {
    "kind": "emulated",
    "files": {
      "support_matrix.md": [
        "# Support matrix (as of 2026-06-01)",
        "",
        "| Version | Status  | Notes                          |",
        "| ------- | ------- | ------------------------------ |",
        "| 9.0     | current | Latest feature release         |",
        "| 8.1     | LTS     | Long-term support until 2028   |",
        "| 8.0     | EOL     | End of life 2025-12-01         |",
        "| 7.4     | EOL     | End of life 2024-06-01         |",
        "",
        "Do not confuse 8.0 (EOL) with 8.1 (LTS)."
      ],
      "blog_snip.txt": [
        "Some posts still call 8.0 'current' — ignore outdated marketing copy."
      ]
    },
    "expected_submit": "LTS",
    "required_tools": [
      "submit"
    ]
  },
  "evaluation": "submit",
  "max_turns": 12,
  "suite": "fb_weak_binding"
}
