{
  "name": "patch_config",
  "title": "Patch Config And Test",
  "mode": "benchmark",
  "system": "base",
  "prompt": "app.conf is still on development. Flip mode to production, verify with the tests, and once they pass report just the word production.",
  "tools": "write",
  "environment": {
    "kind": "emulated",
    "files": {
      "app.conf": [
        "mode = development"
      ]
    },
    "expected_submit": "production",
    "required_tools": [
      "read_file",
      "write_file",
      "run_tests",
      "submit"
    ],
    "scenario": "patch_config"
  },
  "evaluation": "submit_after_tests",
  "max_turns": 14,
  "suite": "original"
}
