{
  "name": "jsonl_event_aggregate",
  "title": "JSONL Event Aggregate",
  "mode": "benchmark",
  "system": "base",
  "prompt": "Read events.jsonl and README.md. For every line with checkout and success (include the last line): count it, track distinct users, and add that line's amount into revenue. Submit one line: orders=N users=N revenue=N.NN",
  "tools": "nav",
  "environment": {
    "kind": "emulated",
    "files": {
      "events.jsonl": [
        "{\"event\":\"checkout\",\"status\":\"success\",\"user\":\"u1\",\"amount\":49.99}",
        "{\"event\":\"checkout\",\"status\":\"failed\",\"user\":\"u2\",\"amount\":19.99}",
        "{\"event\":\"view\",\"status\":\"success\",\"user\":\"u3\",\"amount\":0}",
        "{\"event\":\"checkout\",\"status\":\"success\",\"user\":\"u2\",\"amount\":80.00}",
        "{\"event\":\"checkout\",\"status\":\"success\",\"user\":\"u1\",\"amount\":12.50}",
        "{\"event\":\"checkout\",\"status\":\"success\",\"user\":\"u3\",\"amount\":100.25}",
        "{\"event\":\"refund\",\"status\":\"success\",\"user\":\"u3\",\"amount\":25.00}",
        "{\"event\":\"checkout\",\"status\":\"success\",\"user\":\"u4\",\"amount\":63.00}",
        "{\"event\":\"checkout\",\"status\":\"success\",\"user\":\"u5\",\"amount\":132.98}"
      ],
      "README.md": [
        "A matching row looks like: \"event\":\"checkout\",\"status\":\"success\".",
        "There are multiple matching rows — count all of them, including the last line.",
        "Submit one line: orders=N users=N revenue=N.NN",
        "run_lua example skeleton: local t=0; for line in FILES['events.jsonl']:gmatch('[^\\n]+') do ... end; print(...)"
      ]
    },
    "expected_submit": "orders=6 users=5 revenue=438.72",
    "required_tools": [
      "read_file",
      "submit"
    ]
  },
  "evaluation": "submit",
  "max_turns": 16,
  "suite": "original"
}
